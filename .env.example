# Alienese serving
ALIENESE_ENV=development
ALIENESE_LOG_LEVEL=INFO
ALIENESE_TRACE_CONTENT=false

# Retriever provider
RETRIEVER_API_KEY=
RETRIEVER_BASE_URL=
RETRIEVER_MODEL=google/embeddinggemma-2

# Controller provider
CONTROLLER_API_KEY=
CONTROLLER_BASE_URL=
CONTROLLER_MODEL=samatv256/mini-Jev

# Generator provider — NVIDIA Nemotron through Nebius Token Factory
GENERATOR_API_KEY=
GENERATOR_BASE_URL=https://api.tokenfactory.nebius.com/v1
GENERATOR_MODEL=

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
