# Alienese serving (defaults to loopback-only and offline fake provider mode)
ALIENESE_ENV=development
ALIENESE_HOST=127.0.0.1
ALIENESE_PORT=8000
ALIENESE_LOG_LEVEL=INFO
ALIENESE_TRACE_CONTENT=false
ALIENESE_PROVIDER_MODE=fake

# Shared remote-provider runtime bounds
ALIENESE_PROVIDER_TIMEOUT_SECONDS=30.0
ALIENESE_PROVIDER_MAX_ATTEMPTS=2
ALIENESE_PROVIDER_RETRY_AMBIGUOUS=false
ALIENESE_PROVIDER_MAX_CONCURRENCY=8
ALIENESE_PROVIDER_MAX_QUEUE_WAITERS=16
ALIENESE_PROVIDER_CB_FAILURE_THRESHOLD=5
ALIENESE_PROVIDER_CB_RECOVERY_SECONDS=30.0

# Retriever provider (EmbeddingGemma 2 — fake in Phase 2)
RETRIEVER_PROVIDER=fake
RETRIEVER_API_KEY=
RETRIEVER_BASE_URL=
RETRIEVER_MODEL=google/embeddinggemma-2

# Controller provider (mini-Jev — fake in Phase 2)
CONTROLLER_PROVIDER=fake
CONTROLLER_API_KEY=
CONTROLLER_BASE_URL=
CONTROLLER_MODEL=samatv256/mini-Jev

# Generator provider — set ALIENESE_PROVIDER_MODE=hybrid and GENERATOR_PROVIDER=nvidia_build
# or GENERATOR_PROVIDER=nebius_token_factory
GENERATOR_PROVIDER=fake
GENERATOR_API_KEY=
GENERATOR_BASE_URL=https://integrate.api.nvidia.com/v1
GENERATOR_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_TOKEN_FACTORY_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_TOKEN_FACTORY_MODEL=nvidia/nemotron-3-super-120b-a12b
GENERATOR_MAX_TOKENS=1024
GENERATOR_ENABLE_THINKING=false

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
